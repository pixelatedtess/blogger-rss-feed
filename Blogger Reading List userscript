      --brr-muted: #747e78;
      --brr-line: #e7ded5;
      --brr-sage: #708f80;
      --brr-sage-light: #e6efe8;
      --brr-rose: #f3e3dd;
      background-color: #f7f3ec !important;
    }
    /* Use a locally stored data URL first. The Pinterest link is fallback only.
       This avoids third-party hotlinking once the user imports the JPG. */
    /* Actual full-screen wallpaper. The normal layer sits behind Blogger's feed;
       the always-visible layer solves Blogger's opaque nested containers. */
    #brr-wallpaper {
      display: none;
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image: linear-gradient(rgba(251,247,241,.39), rgba(251,247,241,.39)),
        var(--brr-pattern-image, url("https://i.pinimg.com/1200x/52/d8/e6/52d8e6922222082948e5290da89a1734.jpg"));
      background-position: top left, top left;
