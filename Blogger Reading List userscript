    #brr-search .brr-search-status { display:block; margin-top: 8px; font-size: 11px; color:#64766d; }
    #brr-search .brr-search-tip { display:block; font-size: 10px; color:#7b8b80; margin-top: 3px; }

    /* The settings panel also switches to light-on-dark in evening mode. */
    body.brr-theme-dark #brr-search,
    body.brr-theme-dark #brr-panel,
    body.brr-theme-dark #brr-controls .brr-launcher {
      background: #24323b; color: #f1f5f7; border-color: #54616b;
    }
    body.brr-theme-dark #brr-controls :is(.brr-title, .brr-description,
      .brr-eyebrow, .brr-footer, .brr-count, .brr-import-header,
      .brr-import-description, .brr-image-status) { color: #e5edef !important; }
    body.brr-theme-dark #brr-controls .brr-setting,
    body.brr-theme-dark #brr-controls .brr-import {
      background: #2c3b45; color: #f1f5f7; border-color: #53646c;
    }
    body.brr-theme-dark #brr-controls .brr-setting small,
    body.brr-theme-dark #brr-search :is(.brr-search-status, .brr-search-tip) { color:#c8d6dc; }
    body.brr-theme-dark #brr-controls .brr-setting:hover { background: #364954; }
    body.brr-theme-dark #brr-search :is(input, select) {
      background: #17242d; color: #f3f6f7; border-color:#687985;
    }
    body.brr-theme-dark #brr-search input::placeholder { color: #bbcbd2; }
    body.brr-theme-dark #brr-search .brr-search-clear,
    body.brr-theme-dark #brr-controls .brr-close {
      background: #42535d; color:#f6fafb; border-color:#697982;
    }
    body.brr-theme-dark #brr-controls .brr-setting .brr-state {
      background:#50606a; color:#f4f7f9;
    }
    body.brr-theme-dark #brr-controls .brr-setting[aria-pressed="true"] .brr-state {
      background:#416b58; color:#f3fff6;
    }
    @media (max-width:650px) {
      #brr-controls { right:12px; bottom:12px; }
      #brr-panel { width:min(320px, calc(100vw - 24px)); }
      #brr-search { top: 66px; right: 12px; padding: 10px; }
      #brr-search select { width: 108px; }
      body.brr-clean [data-brr-card] {
        padding: 17px 18px !important; margin: 17px 8px 22px !important;
      }
    }
    @media (prefers-reduced-motion:reduce) {
      #brr-controls .brr-launcher, body.brr-clean [data-brr-card] { transition:none; }
    }
  `;

  let controls = null;
  let searchBar = null;
  let scanTimer = null;
  const search = { query: '', field: 'all' };

  function normalize(text) {
    return String(text || '').normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase().trim();
  }

  function searchTerms(value) {
    // Plain words are ANDed; quoted text is kept as one phrase.
    const terms = [];
    for (const part of value.matchAll(/"([^"]+)"|(\S+)/g)) {
      const term = normalize(part[1] || part[2]);
      if (term) terms.push(term);
    }
    return terms;
  }

  function cardSearchFields(card) {
    const text = card.textContent || '';
    const title = Array.from(card.querySelectorAll(
      '[data-brr-primary], h1, h2, h3, h4, [role="heading"]'
    )).map(el => el.textContent || '').join(' ');
    const tags = Array.from(card.querySelectorAll(
      '[rel="tag"], [itemprop="keywords"], [class*="topic" i], ' +
      '[class*="tag" i], [class*="label" i], a[href*="/search/label/"]'
    )).map(el => el.textContent || '').join(' ');
    const authors = Array.from(card.querySelectorAll(
      '[rel="author"], [itemprop="author"], [class*="author" i], ' +
      '[class*="byline" i], [class*="poster" i], [class*="blog-name" i], ' +
      '[class*="blog-title" i], [class*="source-name" i], ' +
      '[class*="publisher" i], a[href*="/profile/"]'
    )).map(el => el.textContent || '').join(' ');
    let domain = '';
    try { domain = new URL(card.dataset.brrUrl).hostname.replace(/^www\./, ''); }
    catch { /* not a valid URL */ }
    return {
      all: normalize(`${text} ${domain}`),
      keywords: normalize(text),
      topic: normalize(`${title} ${tags}`),
      author: normalize(`${authors} ${domain}`)
    };
  }

  function updateCounter(cards = document.querySelectorAll('[data-brr-card]')) {
    if (!controls) return;
    const total = cards.length;
    const done = Array.from(cards).filter(c => c.dataset.brrRead === 'true').length;
    const counter = controls.querySelector('.brr-count');
    const label = `${done}/${total} read`;
    if (counter && counter.textContent !== label) counter.textContent = label;
  }

  function applyFilters() {
    if (!onReadingList()) return;
    const cards = document.querySelectorAll('[data-brr-card]');
    const terms = searchTerms(search.query);
    let visible = 0;
    for (const card of cards) {
      const haystack = terms.length ? cardSearchFields(card)[search.field] : '';
      const matches = terms.every(term => haystack.includes(term));
      card.dataset.brrFiltered = matches ? 'false' : 'true';
      if (matches && !(options.hideRead && card.dataset.brrRead === 'true')) visible++;
    }
    const status = searchBar?.querySelector('.brr-search-status');
    const label = `${visible} of ${cards.length} loaded posts visible` +
      (options.hideRead ? ' (read hidden)' : '');
    if (status && status.textContent !== label) status.textContent = label;
    const clear = searchBar?.querySelector('.brr-search-clear');
    if (clear) clear.hidden = !search.query;
    updateCounter(cards);
  }

  function refreshPattern() {
    if (!document.documentElement) return;
    // Avoid needlessly reapplying a large data URL during feed updates.
    if (appliedPattern !== storedPattern) {
      if (storedPattern) {
        document.documentElement.style.setProperty('--brr-pattern-image', `url("${storedPattern}")`);
      } else {
        document.documentElement.style.removeProperty('--brr-pattern-image');
      }
      appliedPattern = storedPattern;
    }
    if (!controls) return;
    const status = controls.querySelector('.brr-image-status');
    const preview = controls.querySelector('.brr-image-preview');
    const clear = controls.querySelector('.brr-clear-image');
    if (status && !status.dataset.error) {
      const next = storedPattern ? '✓ Imported image saved in this browser' : 'Using online image (may be blocked)';
      // Avoid an endless MutationObserver -> scan -> text replacement cycle.
      if (status.textContent !== next) status.textContent = next;
    }
    if (clear) clear.hidden = !storedPattern;
    if (preview) {
      preview.dataset.ready = storedPattern ? 'true' : 'false';
      preview.style.backgroundImage = storedPattern ? `url("${storedPattern}")` : '';
    }
  }

  async function importImage(file) {
    if (!file) return;
    const status = controls?.querySelector('.brr-image-status');
    if (status) {
      delete status.dataset.error;
      status.textContent = 'Preparing your pattern…';
    }
    try {
      if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
        throw new Error('Please choose a JPG, PNG or WebP image.');
      }
      if (file.size > 20 * 1024 * 1024) throw new Error('Please choose an image under 20 MB.');
      const bitmap = await createImageBitmap(file);
      try {
        const scale = Math.min(1, 900 / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement('canvas');
        canvas.width = Math.max(1, Math.round(bitmap.width * scale));
        canvas.height = Math.max(1, Math.round(bitmap.height * scale));
        const ctx = canvas.getContext('2d');
        if (!ctx) throw new Error('Could not prepare the image on this browser.');
        ctx.fillStyle = '#f7f3ec';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        const image = canvas.toDataURL('image/jpeg', 0.83);
        // Avoid excessive storage use, even if the original image is large.
        if (image.length > 4000000) throw new Error('Image is still too large to save. Try a smaller JPG.');
        localStorage.setItem(IMAGE_KEY, image);
        storedPattern = image;
      } finally {
        if (typeof bitmap.close === 'function') bitmap.close();
      }
      refreshPattern();
      if (status) {
        delete status.dataset.error;
        status.textContent = '✓ Imported! The image will repeat behind your feed.';
      }
    } catch (error) {
      if (status) {
        status.dataset.error = 'true';
        status.textContent = error?.message || 'The image could not be imported.';
      }
    }
  }

  function refreshUI() {
    if (!document.body) return;
    const reading = onReadingList();
    if (controls) controls.hidden = !reading;
    if (searchBar) searchBar.hidden = !reading;
    document.body.classList.toggle('brr-clean', reading && options.clean);
    document.body.classList.toggle('brr-pattern', reading && options.pattern);
    document.body.classList.toggle('brr-force-pattern', reading && options.pattern && options.visiblePattern);
    document.body.classList.toggle('brr-theme-dark', reading && options.dark);
    document.body.classList.toggle('brr-hide-read', reading && options.hideRead);
    refreshPattern();
    if (!controls) return;
    for (const id of Object.keys(DEFAULTS)) {
      const btn = controls.querySelector(`[data-option="${id}"]`);
      if (!btn) continue;
      btn.setAttribute('aria-pressed', String(!!options[id]));
      const pill = btn.querySelector('.brr-state');
      const label = options[id] ? 'On' : 'Off';
      if (pill && pill.textContent !== label) pill.textContent = label;
    }
    applyFilters();
  }

  function setup() {
    if (!document.body || controls) return;
    document.head.append(style);
    if (!document.querySelector('#brr-wallpaper')) {
      const wallpaper = document.createElement('div');
      wallpaper.id = 'brr-wallpaper';
      wallpaper.setAttribute('aria-hidden', 'true');
      document.body.prepend(wallpaper);
    }
    controls = document.createElement('div');
    controls.id = 'brr-controls';
    controls.setAttribute('role', 'region');
    controls.setAttribute('aria-label', 'Reading List Cleaner settings');
    controls.innerHTML = `
      <button class="brr-launcher" type="button" aria-controls="brr-panel" aria-expanded="false"
              aria-label="Customize Reading List">
        <span class="brr-flower" aria-hidden="true">✿</span>
        <span>Reading List</span>
        <span class="brr-sliders" aria-hidden="true">☷</span>
      </button>
      <div id="brr-panel" role="group" aria-label="Reading List appearance settings" hidden>
        <div class="brr-panel-top">
          <div><div class="brr-eyebrow">Make it yours</div><strong class="brr-title">Reading nook</strong></div>
          <button class="brr-close" type="button" aria-label="Close settings">×</button>
        </div>
        <p class="brr-description">Custom reader list</p>
        <div class="brr-settings">
          <button type="button" class="brr-setting" data-option="clean" aria-pressed="true">
            <span class="brr-setting-label">Soft layout<small>Comfortable cards and typography</small></span>
            <span class="brr-state">On</span>
          </button>
          <button type="button" class="brr-setting" data-option="pattern" aria-pressed="true">
            <span class="brr-setting-label">Pattern background<small>Repeating mosaic, gently faded</small></span>
            <span class="brr-state">On</span>
          </button>
          <div class="brr-import">
            <div class="brr-import-header">Your background image</div>
            <div class="brr-import-description">Pinterest may block direct image links. Save the JPG, then import it once. It stays in this browser.</div>
            <div class="brr-import-buttons">
              <button type="button" class="brr-import-button">Choose image…</button>
              <button type="button" class="brr-clear-image" hidden>Remove</button>
            </div>
            <input class="brr-image-file" type="file" accept="image/jpeg,image/png,image/webp" aria-label="Choose repeating background image">
            <div class="brr-image-status" role="status" aria-live="polite">Using online image (may be blocked)</div>
            <div class="brr-image-preview" role="img" aria-label="Background image preview"></div>
          </div>
          <button type="button" class="brr-setting" data-option="visiblePattern" aria-pressed="true">
            <span class="brr-setting-label">Always-visible pattern<small>Shows the design through Blogger's white panels</small></span>
            <span class="brr-state">On</span>
          </button>
          <button type="button" class="brr-setting" data-option="dark" aria-pressed="false">
            <span class="brr-setting-label">Evening colors<small>Warm and muted, never jet-black</small></span>
            <span class="brr-state">Off</span>
          </button>
          <button type="button" class="brr-setting" data-option="hideRead" aria-pressed="false">
            <span class="brr-setting-label">Hide read posts<small>Keep only your unread items visible</small></span>
            <span class="brr-state">Off</span>
          </button>
        </div>
        <div class="brr-footer"><span class="brr-count">0/0 read</span><span>✿ Happy reading</span></div>
      </div>`;
    const input = controls.querySelector('.brr-image-file');
    controls.querySelector('.brr-import-button').addEventListener('click', () => input.click());
    input.addEventListener('change', () => {
      const file = input.files?.[0];
      input.value = '';
      if (file) void importImage(file);
    });
    controls.querySelector('.brr-clear-image').addEventListener('click', () => {
      try { localStorage.removeItem(IMAGE_KEY); } catch { /* storage restricted */ }
      storedPattern = null;
      const status = controls.querySelector('.brr-image-status');
      if (status) delete status.dataset.error;
      refreshPattern();
    });
    const launcher = controls.querySelector('.brr-launcher');
    const panel = controls.querySelector('#brr-panel');
    const setOpen = open => {
      panel.hidden = !open;
      launcher.setAttribute('aria-expanded', String(open));
    };
    launcher.addEventListener('click', () => setOpen(panel.hidden));
    controls.querySelector('.brr-close').addEventListener('click', () => {
      setOpen(false);
      launcher.focus();
    });
    for (const key of Object.keys(DEFAULTS)) {
      controls.querySelector(`[data-option="${key}"]`).addEventListener('click', () => {
        options[key] = !options[key];
        saveOptions();
        refreshUI();
      });
    }
    document.addEventListener('pointerdown', e => {
      if (!panel.hidden && !controls.contains(e.target)) setOpen(false);
    }, {passive:true});
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        launcher.focus();
      }
    });
    document.body.append(controls);

    searchBar = document.createElement('div');
    searchBar.id = 'brr-search';
    searchBar.setAttribute('role', 'search');
    searchBar.setAttribute('aria-label', 'Filter Blogger reading list');
    searchBar.innerHTML = `
      <label class="brr-search-title" for="brr-search-input">⌕ Find a post</label>
      <div class="brr-search-row">
        <input id="brr-search-input" type="search" autocomplete="off"
          placeholder="Search reading list…" aria-label="Search reading list">
        <select aria-label="Search in">
          <option value="all">Everything</option>
          <option value="topic">Topic / tags</option>
          <option value="keywords">Keywords</option>
          <option value="author">Author / blog</option>
        </select>
        <button class="brr-search-clear" type="button" hidden aria-label="Clear search">×</button>
      </div>
      <span class="brr-search-status" role="status" aria-live="polite">0 posts found</span>
      <span class="brr-search-tip">Searches posts Blogger has loaded; scroll to load more.</span>`;
    const searchInput = searchBar.querySelector('input');
    searchInput.addEventListener('input', () => {
      search.query = searchInput.value;
      applyFilters();
    });
    searchBar.querySelector('select').addEventListener('change', e => {
      search.field = e.target.value;
      applyFilters();
    });
    searchBar.querySelector('.brr-search-clear').addEventListener('click', () => {
      search.query = '';
      searchInput.value = '';
      applyFilters();
      searchInput.focus();
    });
    document.body.append(searchBar);
    refreshUI();
  }

  function exposeOpaqueLayers() {
    // Also supports the behind-the-content mode. Only expose big layout surfaces,
    // never individual post cards, controls, buttons or sidebar elements.
    const root = document.querySelector('main, [role="main"], .mat-drawer-content, .mat-sidenav-content, .mdl-layout__content');
    if (!root) return;
    for (let node = root; node && node !== document.body; node = node.parentElement) {
      if (node instanceof HTMLElement) node.classList.add('brr-clear-surface');
    }
    const minW = Math.min(300, innerWidth * .65);
    const nodes = [root, ...Array.from(root.querySelectorAll('*')).slice(0, 1200)];
    for (const node of nodes) {
      if (!(node instanceof HTMLElement)) continue;
      if (node.closest('#brr-controls, #brr-search, [data-brr-card], article, [role="article"], nav, aside, header, footer, button')) continue;
      const box = node.getBoundingClientRect();
      if (box.width >= minW && box.height >= 210) node.classList.add('brr-clear-surface');
    }
  }

  function scan() {
    scanTimer = null;
    setup();
    refreshUI();
    if (!onReadingList()) return;
    exposeOpaqueLayers();
    const root = document.querySelector('main, [role="main"]') || document.body;
    const anchors = Array.from(root.querySelectorAll('a[href]'));
    for (const a of anchors) {
      if (!relevantAnchor(a) || scoreAnchor(a) < 15) continue;
      if (a.closest('[data-brr-card]')) continue;
      const card = findCard(a, root);
      if (!card || card.hasAttribute('data-brr-card') ||
          card.querySelector('[data-brr-card]') ||
          card.contains(controls) || card.contains(searchBar)) continue;
      const data = getBestPostLink(card);
      if (data?.url && scoreAnchor(data.anchor) >= 15) enhance(card, data);
    }
    applyFilters();
  }

  function scheduleScan() {
    if (scanTimer === null) scanTimer = setTimeout(scan, 160);
  }

  // Catch the click before Blogger's application handler when the original URL
  // is visible in the DOM. Leave unsupported / suspicious links untouched.
  window.addEventListener('click', (event) => {
    if (!onReadingList() || event.defaultPrevented || event.button !== 0 ||
        event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null;
    const card = anchor?.closest('[data-brr-card]');
    if (!card || !anchor || !relevantAnchor(anchor)) return;
    const isPrimary = anchor.hasAttribute('data-brr-primary');
    const isReadMore = /read more|view (?:full )?post|continue reading|full article/i.test(anchor.textContent || '');
    if (!isPrimary && !isReadMore) return;
    const target = destinationFor(anchor);
    if (!target) return;
    event.preventDefault();
    event.stopImmediatePropagation();
    openDirect(target, card);
  }, true);

  function start() {
    setup();
    scan();
    new MutationObserver(scheduleScan).observe(document.body, { childList: true, subtree: true });
    window.addEventListener('popstate', scheduleScan);
    window.addEventListener('hashchange', scheduleScan);
    // Blogger may use history.pushState without popstate; DOM mutations catch
    // the normal SPA transition. This low-frequency check handles silent routes.
    setInterval(() => {
      const visible = controls && !controls.hidden;
      if (visible !== onReadingList()) scheduleScan();
    }, 1800);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else start();
})();
