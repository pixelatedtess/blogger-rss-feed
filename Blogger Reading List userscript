    /* The optional visible texture sits over Blogger's blank surfaces, but
       never over the actual reading content or its solid post bubbles. */
    body.brr-force-pattern #brr-wallpaper {
      background-image: var(--brr-pattern-image, url("https://i.pinimg.com/1200x/52/d8/e6/52d8e6922222082948e5290da89a1734.jpg"));
      background-size: 320px auto;
