// ==UserScript==
// @name         Blogger Reading List — Cleaner Edition
// @namespace    https://local.userscripts.example/blogger-reading-list
// @version      0.5.0
// @description  readable dark mode, live topic/keyword/author search, wallpaper import, original links and read tracking.
// @match        https://www.blogger.com/*
// @match        https://blogger.com/*
// @match        https://draft.blogger.com/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(() => {
  'use strict';

  const PREFIX = 'brr-v1-';
  const OPT_KEY = PREFIX + 'options';
  const READ_KEY = PREFIX + 'read';
  const IMAGE_KEY = PREFIX + 'custom-background';
  // A locally imported pattern stays in this browser; the image is not uploaded anywhere.
  let storedPattern = null;
  let appliedPattern = undefined;
  try {
    const value = localStorage.getItem(IMAGE_KEY);
    if (value && /^data:image\/(?:jpeg|png|webp);base64,[A-Za-z0-9+/=]+$/.test(value)) {
      storedPattern = value;
    }
  } catch { /* storage unavailable */ }

  const DEFAULTS = { clean: true, pattern: true, visiblePattern: true, dark: false, hideRead: false };

  function load(key, fallback) {
    try {
      const value = JSON.parse(localStorage.getItem(key));
      return value && typeof value === 'object' ? value : fallback;
    } catch { return fallback; }
  }
  const options = { ...DEFAULTS, ...load(OPT_KEY, DEFAULTS) };
  const read = load(READ_KEY, {});
  const saveOptions = () => { try { localStorage.setItem(OPT_KEY, JSON.stringify(options)); } catch { /* storage disabled */ } };
  const saveRead = () => {
    // Bound storage growth: keep the 1200 most recently marked posts.
    const entries = Object.entries(read).sort((a, b) => b[1] - a[1]).slice(0, 1200);
    for (const key of Object.keys(read)) delete read[key];
    for (const [key, date] of entries) read[key] = date;
    try { localStorage.setItem(READ_KEY, JSON.stringify(read)); } catch { /* quota */ }
  };

  function onReadingList() {
    return /\/(?:u\/\d+\/)?(?:dashboard\/reading|blog\/reading)(?:\/|$)/.test(location.pathname);
  }

  function validDestination(value, base = location.href) {
    if (!value || typeof value !== 'string') return null;
    try {
      const u = new URL(value, base);
      if (!['https:', 'http:'].includes(u.protocol) || u.username || u.password) return null;
      if (!u.hostname || u.hostname === 'localhost') return null;
      return u.href;
    } catch { return null; }
  }

  function isGoogleHost(host) {
    return /^(?:www\.)?google\.(?:com|cz|sk|de|fr|pl|ca|co\.uk|com\.au)$/.test(host);
  }

  function unwrapKnownRedirect(href) {
    const url = new URL(href);
    const host = url.hostname.toLowerCase();
    const googleURL = isGoogleHost(host) && url.pathname === '/url';
    const bloggerRedirect = /^(?:www\.)?blogger\.com$/.test(host) &&
      /^\/(?:blog-redirect\.g|redirect)(?:\/|$)/.test(url.pathname);
    if (!googleURL && !bloggerRedirect) return null;
    for (const param of ['url', 'q', 'u']) {
      const raw = url.searchParams.get(param);
      if (!raw || !/^https?:\/\//i.test(raw)) continue;
      const candidate = validDestination(raw);
      if (candidate) return candidate;
    }
    return null;
  }

  function isBloggerDashboard(href) {
    const u = new URL(href);
    return /^(?:www\.|draft\.)?blogger\.com$/.test(u.hostname) &&
      /^\/(?:u\/\d+\/)?(?:dashboard|blog|blogger\.g)(?:\/|$)/.test(u.pathname);
  }

  function destinationFor(anchor) {
    if (!anchor) return null;
    const raw = anchor.getAttribute('href');
    const href = validDestination(raw);
    if (!href) return null;
    const unwrapped = unwrapKnownRedirect(href);
    if (unwrapped) return unwrapped;
    // A Google redirect without a recoverable URL is deliberately left alone.
    const u = new URL(href);
    if (isGoogleHost(u.hostname) && u.pathname === '/url') return null;
    if (isBloggerDashboard(href)) return null;
    return href;
  }

  function relevantAnchor(a) {
    return !a.closest('nav, header, aside, footer, [role="navigation"], #brr-controls, #brr-search, .brr-actions') &&
      !/^(?:edit|manage|settings|follow|unfollow|delete)$/i.test((a.textContent || '').trim());
  }

  // 
  function hasMultiplePosts(container) {
    const postLinks = new Set();
    for (const link of container.querySelectorAll('a[href]')) {
      const url = destinationFor(link);
      if (!url) continue;
      const path = new URL(url).pathname;
      const looksLikePost = /\/(?:19|20)\d\d\/\d\d\//.test(path) ||
        /\.html?$/.test(path) ||
        !!link.closest('h1,h2,h3,h4,[role="heading"]') ||
        /read more|continue reading|full article/i.test(link.textContent || '');
      if (looksLikePost) postLinks.add(url.split('#')[0]);
      if (postLinks.size > 1) return true;
    }
    return false;
  }

  function findCard(a, root) {
    const known = a.closest('article, [role="article"], [class*="feed-item" i], [class*="reading-list-item" i], [class*="post-card" i], [class*="post-item" i]');
    if (known && known !== root && (known.textContent || '').trim().length >= 45 &&
        !hasMultiplePosts(known)) return known;

    // 
    let chosen = null;
    let node = a.parentElement;
    for (let depth = 0; node && node !== root && depth < 11; depth++, node = node.parentElement) {
      if (!(node instanceof HTMLElement) || node.closest('#brr-controls, #brr-search')) break;
      if (node.querySelector('[data-brr-card]')) break;
      const textLength = (node.textContent || '').trim().length;
      const count = node.querySelectorAll('a[href]').length;
      const height = node.getBoundingClientRect().height;
      if (count > 16 || textLength > 8000 || height > 1400 || hasMultiplePosts(node)) break;
      if (textLength >= 45 && count <= 16 &&
          (height === 0 || (height >= 45 && height <= 1200))) chosen = node;
    }
    return chosen;
  }

  function scoreAnchor(anchor) {
    const dest = destinationFor(anchor);
    if (!dest || !relevantAnchor(anchor)) return -999;
    const label = (anchor.innerText || anchor.textContent || '').trim();
    const path = new URL(dest).pathname;
    let score = 0;
    if (/\/(?:19|20)\d\d\/\d\d\//.test(path)) score += 50;
    if (/\.(html?|aspx?)(?:$)/i.test(path)) score += 15;
    if (/read more|view (?:full )?post|continue reading|full article|read full/i.test(label)) score += 60;
    if (anchor.closest('h1, h2, h3, h4, [role="heading"]')) score += 70;
    if (label.length >= 18 && label.length <= 180) score += 20;
    if (label.length < 4) score -= 35;
    if (/^(home|blog|profile|author|source|follow)$/i.test(label)) score -= 90;
    return score;
  }

  function getBestPostLink(card) {
    const links = Array.from(card.querySelectorAll('a[href]')).filter(relevantAnchor);
    links.sort((a, b) => scoreAnchor(b) - scoreAnchor(a));
    const best = links[0];
    return best && scoreAnchor(best) >= 0 ? { anchor: best, url: destinationFor(best) } : null;
  }

  function markCard(card, url, shouldMark) {
    if (shouldMark) read[url] = Date.now();
    else delete read[url];
    saveRead();
    card.dataset.brrRead = shouldMark ? 'true' : 'false';
    const btn = card.querySelector('.brr-mark');
    if (btn) btn.textContent = shouldMark ? '✓ Read' : 'Mark read';
    applyFilters();
  }

  function openDirect(url, card) {
    // Only called from an actual user click; never auto-follows a redirect notice.
    window.open(url, '_blank', 'noopener,noreferrer');
    if (card) markCard(card, url, true);
  }

  function enhance(card, data) {
    if (card.hasAttribute('data-brr-card')) return;
    card.dataset.brrCard = '';
    card.dataset.brrUrl = data.url;
    card.dataset.brrRead = read[data.url] ? 'true' : 'false';
    data.anchor.dataset.brrPrimary = 'true';
    // 
    card.style.removeProperty('opacity');

    const actions = document.createElement('div');
    actions.className = 'brr-actions';
    const open = document.createElement('button');
    open.type = 'button';
    open.className = 'brr-open';
    open.textContent = '↗ Open original';
    open.title = `Open original post: ${new URL(data.url).hostname}`;
    open.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      openDirect(data.url, card);
    });
    const mark = document.createElement('button');
    mark.type = 'button';
    mark.className = 'brr-mark';
    mark.textContent = read[data.url] ? '✓ Read' : 'Mark read';
    mark.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      markCard(card, data.url, !read[data.url]);
    });
    actions.append(open, mark);
    card.append(actions);
  }

  const style = document.createElement('style');
  style.id = 'brr-style';
